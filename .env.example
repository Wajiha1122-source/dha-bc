DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
APP_ORIGIN=http://localhost:5173
PORT=3001
NODE_ENV=development
STORAGE_DIR=./private-storage
# Render: use NODE_ENV=production and HOST=0.0.0.0.
# Render supplies PORT and RENDER_EXTERNAL_URL automatically.
# Omit APP_ORIGIN on Render unless using a custom domain.
# TRUST_PROXY=1
# STORAGE_DIR=/var/data/building-control
